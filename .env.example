# Runtime DB connection — dd_app role, routed through PgBouncer
# Format: postgresql+asyncpg://dd_app:<password>@<pgbouncer-host>:5432/<dbname>
DATABASE_URL=postgresql+asyncpg://username-changeme:CHANGEME@pgbouncer:5432/simpero

# Migration DB connection — dd_owner role, direct to DigitalOcean cluster (bypasses PgBouncer)
# NEVER use this URL in runtime application code — DDL privileges only
ALEMBIC_DATABASE_URL=postgresql+psycopg2://username-changeme@<do-cluster-host>:25060/simpero?sslmode=require

# Clerk authentication
# Get from: Clerk Dashboard > API Keys
CLERK_SECRET_KEY=sk_test_CHANGEME
# Get from: Clerk Dashboard > API Keys > JWT Templates
CLERK_JWT_AUDIENCE=CHANGEME
# Clerk JWKS endpoint — format: https://<your-clerk-frontend-api>/.well-known/jwks.json
# TODO: Replace with your actual Clerk frontend API URL from the Clerk dashboard
CLERK_JWKS_URL=https://CHANGEME.clerk.accounts.dev/.well-known/jwks.json

# Job queue — DigitalOcean Managed Valkey (SAQ)
# Get from: DO Dashboard > Databases > your Valkey cluster > Connection Details
# rediss:// (TLS) is required — DO Valkey rejects unencrypted connections from outside its
# private network. ssl_cert_reqs=none matches the sslmode=require (encrypt, don't pin CA)
# posture already used for DATABASE_URL/ALEMBIC_DATABASE_URL above.
VALKEY_URL=rediss://default:CHANGEME@<do-valkey-host>:25061?ssl_cert_reqs=none

# App config
ENVIRONMENT=development
# Comma-separated list of allowed CORS origins
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Parser service (services/parser) — Docling document cache on DigitalOcean
# Spaces (S3-compatible). PARSER_ prefix; read by ParserSettings, not the app.
# The cache stays DISABLED until all four of bucket/endpoint/key/secret are set
# (see document_cache.build_document_cache). The key + secret are a Spaces
# access key, distinct from your DO API token: DO console > API > Spaces Keys >
# Generate New Key (scope it to the bucket, read+write). The secret is shown
# once — paste it straight into .env, never into chat.
PARSER_SPACES_BUCKET=simpero-cim-xlsx-upload
PARSER_SPACES_REGION=tor1
PARSER_SPACES_ENDPOINT_URL=https://tor1.digitaloceanspaces.com
PARSER_SPACES_ACCESS_KEY_ID=CHANGEME
PARSER_SPACES_SECRET_ACCESS_KEY=CHANGEME
# Optional; defaults to parser/document-cache. Namespaces the cache inside the
# bucket so it never collides with other objects (e.g. XLSX uploads).
PARSER_SPACES_KEY_PREFIX=parser/document-cache
