# Local sandbox environment. Safe to commit: these are local-only, well-known
# dev credentials for containers that only ever listen on your machine. Nothing
# here is a real secret.
#
# The sandbox scripts source this. If you run the app or scripts by hand, do:
#   set -a && . sandbox/.env.sandbox && set +a

# Runtime connection -- dd_app, RLS-restricted. Direct to local Postgres on 5433
# (no PgBouncer locally; SET LOCAL works fine on a direct connection -- the
# pooler only matters for connection scaling in production).
DATABASE_URL=postgresql+asyncpg://dd_app:sandbox_dd_app@localhost:5433/simpero

# Migration connection -- doadmin, DDL only. Same host; psycopg2 for alembic.
ALEMBIC_DATABASE_URL=postgresql+psycopg2://doadmin:sandbox_doadmin@localhost:5433/simpero

# Local Valkey (plain redis://, no TLS -- unlike DO's managed Valkey which
# requires rediss://). The end-to-end demo does not use the queue; this is here
# so the app itself can run against the sandbox.
VALKEY_URL=redis://localhost:6380/0

# Auth is a stub (app/core/security.py::decode_clerk_jwt), so these are only
# present to satisfy config validation -- nothing decodes them on the demo path.
CLERK_SECRET_KEY=sandbox
CLERK_JWT_AUDIENCE=sandbox
CLERK_JWKS_URL=https://sandbox.invalid/.well-known/jwks.json

ENVIRONMENT=development
CORS_ALLOWED_ORIGINS=http://localhost:3000
